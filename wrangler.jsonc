{
  "name": "dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODE": "production",
    "SITE": "enabled",
    "JWT_SECRET": "generate-a-secure-random-key",
    "JWT": "generate-a-secure-random-key"
  },
  "env": {
    "production": {
      "vars": {
        "JWT_SECRET": "generate-a-secure-random-key",
        "JWT": "generate-a-secure-random-key"
      }
    }
  },
  "ai": {
    "name": "AI",
    "binding": "AI"
  },
  "d1_databases": [
    { "binding": "timetable", "database_name": "timetable", "database_id": "__D1_ID_TIMETABLE__" },
    { "binding": "subjects_data", "database_name": "subjects_data", "database_id": "__D1_ID_SUBJECTS_DATA__" },
    { "binding": "school_data", "database_name": "school_data", "database_id": "__D1_ID_SCHOOL_DATA__" },
    { "binding": "emails", "database_name": "emails", "database_id": "__D1_ID_EMAILS__" },
    { "binding": "settings", "database_name": "settings", "database_id": "__D1_ID_SETTINGS__" }
  ],
  "workflows": [
    {
      "name": "check_grades",
      "binding": "CHECK_GRADES",
      "class_name": "CheckGradesWorkflow"
    }
  ],
  "triggers": {
    "crons": ["0 */4 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
